{
  "name": "wellness-chatbot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wellness World AI shopping assistant — orchestration backend (OpenAI, retrieval, recommendation, safety).",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "import": "tsx src/cli/import.ts",
    "label": "tsx src/cli/label.ts",
    "seed": "tsx src/cli/seed.ts",
    "//": "The :prod variants run the compiled CLI. Use these inside a container — the image has no tsx and no src/.",
    "seed:prod": "node dist/cli/seed.js",
    "import:prod": "node dist/cli/import.js",
    "label:prod": "node dist/cli/label.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
