# ---------------------------------------------------------------------------
# Wellness World chatbot backend — environment
# Copy to .env and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- OpenAI ---------------------------------------------------------------
# The API key lives ONLY here. It must never appear in PHP or reach the browser.
OPENAI_API_KEY=sk-...

# Model IDs. Verified against OpenAI's live model list on 2026-08-03.
# Re-check before launch — OpenAI's lineup moves roughly monthly (spec §16.7).
#   chat  = balanced-cost reasoning model for live conversation turns
#   cheap = high-volume, low-risk tasks (language detection, normalization)
#   label = flagship, used only for the product auto-labeling pass
OPENAI_MODEL_CHAT=gpt-5.6-terra
OPENAI_MODEL_CHEAP=gpt-5.6-luna
OPENAI_MODEL_LABEL=gpt-5.6-sol
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# --- Storage --------------------------------------------------------------
# SQLite file. Sessions, products, embeddings, KB, escalations and analytics
# all live here — no extra infrastructure to run.
DATABASE_PATH=./data/wellness-chatbot.db

# Session inactivity TTL in minutes (spec §2).
SESSION_TTL_MINUTES=45

# --- WordPress -------------------------------------------------------------
# Used only as the CORS origin the widget is allowed to call from. The backend
# never calls back into the website — product data arrives by push (the
# plugin's queue) or by file (Settings -> Export catalogue, then
# `npm run import:prod`). There is no WooCommerce REST client in this codebase.
WP_BASE_URL=https://www.wellnesspharmacykw.com

# Shared secret for HMAC signing between the WP plugin and this service.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes in wp-config.php as WELLNESS_CHATBOT_SECRET.
WP_SHARED_SECRET=

# --- Behaviour ------------------------------------------------------------
# Products below this AI confidence sort to the top of the Label Review Queue.
LABEL_CONFIDENCE_THRESHOLD=0.6

# Per-session and per-IP rate limits (requests per minute).
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60

# Set to 1 to allow the recommendation engine to include `partial` products.
# Verified-only is the safer launch default; `partial` widens coverage.
ALLOW_PARTIAL_VERIFICATION=1

# Off by default, deliberately. Set to 1 to let ANY admin — not only a user
# holding the Pharmacist Reviewer capability — approve a product flagged
# requires_pharmacist_review (vitamins/supplements, and anything mentioning
# pregnancy, breastfeeding, children, or medicines). The audit trail is
# unaffected: verified_by_pharmacist is only ever set true when an actual
# pharmacist did the approval, regardless of this setting.
ALLOW_NON_PHARMACIST_APPROVAL=0
